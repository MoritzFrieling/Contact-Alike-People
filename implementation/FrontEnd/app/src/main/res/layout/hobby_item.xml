<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="visible">

    <TextView
        android:id="@+id/textStartDate"
        android:layout_width="211dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="51dp"
        android:layout_marginTop="60dp"
        android:text="Click to select a date"
        android:textAlignment="center"
        android:textSize="20sp" />

    <Spinner
        android:id="@+id/spinnerLevel"
        android:layout_width="139dp"
        android:layout_height="58dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="9dp"
        android:entries="@array/level_of_proficiency"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/imageInterest"
        android:layout_width="50dp"
        android:layout_height="57dp"
        app:srcCompat="?android:attr/textSelectHandleLeft"
        app:tint="#F0711C" />

    <TextView
        android:id="@+id/textInterestName"
        android:layout_width="wrap_content"
        android:layout_height="33dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="50dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="157dp"
        android:text="Interest name"
        android:textAlignment="textStart"
        android:textSize="24sp" />

</RelativeLayout>