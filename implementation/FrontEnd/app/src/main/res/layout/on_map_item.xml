<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/bluecardid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTintMode="add"
        app:cardCornerRadius="20dp">

        <FrameLayout
            android:id="@+id/frameorangeid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F0711C"
            android:padding="3dp"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:id="@+id/topcardid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#363D45"
                app:cardCornerRadius="30dp">

                <ScrollView
                    android:id="@+id/scrollid"
                    android:layout_width="250dp"
                    android:layout_height="292dp">

                    <LinearLayout
                        android:id="@+id/mainlayoutid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/frametopid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="50dp"
                            android:layout_marginBottom="20dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/carditin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="100dp">

                                <ImageView
                                    android:id="@+id/onMapPic"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    tools:srcCompat="@tools:sample/avatars" />
                            </androidx.cardview.widget.CardView>
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/iditin3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="15dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/onMapName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_weight="1"
                                android:text="name here"
                                android:textColor="#F5F5F5"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/onMapBirthdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_weight="1"
                                android:text="birthdate here"
                                android:textColor="#28AFB0"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/iditn2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/onMapHobbyTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginBottom="5dp"
                                android:text="Interests:"
                                android:textColor="#F5F5F5"
                                android:textSize="20sp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/onMapInterestRecycler"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/iditin"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/onMapSocialTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_marginBottom="5dp"
                                android:text="I'm active on these platforms: "
                                android:textColor="#F5F5F5"
                                android:textSize="20sp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/onMapSocialRecycler"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textView27"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="20dp"
                            android:text="Click the button below to send a request to the person with your social contact data!"
                            android:textAlignment="center"
                            android:textColor="#DDD7D7"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/onMapRequestContact2"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="70dp"
                            android:backgroundTint="#28AFB0"
                            android:text="Get in touch!" />
                    </LinearLayout>
                </ScrollView>
            </androidx.cardview.widget.CardView>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>